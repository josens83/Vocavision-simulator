// VocaVision 학습 플랫폼 데이터베이스 스키마

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 인증 관련 모델 (NextAuth)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  wordProgress  WordProgress[]
  quizResults   QuizResult[]
  achievements  UserAchievement[]
  streaks       LearningStreak[]
  gameScores    GameScore[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 구독 및 결제 관련 모델
// ============================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Payment {
  id              String   @id @default(cuid())
  stripePaymentId String   @unique
  amount          Int
  currency        String   @default("krw")
  status          String
  userId          String
  createdAt       DateTime @default(now())

  @@map("payments")
}

// ============================================
// 단어 학습 관련 모델
// ============================================

model Word {
  id           String   @id @default(cuid())
  english      String
  korean       String
  pronunciation String?
  example      String?
  exampleKorean String?
  imageUrl     String?
  audioUrl     String?
  mnemonic     String?  // AI 생성 연상법
  difficulty   Difficulty @default(MEDIUM)
  category     String
  level        Int      @default(1) // 1-10 레벨
  tags         String[] // 태그 배열
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  progress     WordProgress[]
  quizQuestions QuizQuestion[]

  @@unique([english, category])
  @@map("words")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model WordProgress {
  id              String   @id @default(cuid())
  userId          String
  wordId          String

  // SM-2 알고리즘 관련 필드
  easeFactor      Float    @default(2.5)
  interval        Int      @default(0)     // 다음 복습까지 일수
  repetitions     Int      @default(0)     // 연속 정답 횟수
  nextReviewDate  DateTime @default(now())
  lastReviewDate  DateTime?

  // 학습 상태
  status          LearningStatus @default(NEW)
  correctCount    Int      @default(0)
  incorrectCount  Int      @default(0)
  totalReviews    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@map("word_progress")
}

enum LearningStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

// ============================================
// 퀴즈 관련 모델
// ============================================

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        QuizType
  category    String?
  difficulty  Difficulty @default(MEDIUM)
  timeLimit   Int?     // 초 단위
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())

  questions   QuizQuestion[]
  results     QuizResult[]

  @@map("quizzes")
}

enum QuizType {
  FLASHCARD
  MULTIPLE_CHOICE
  TYPING
  LISTENING
  MIXED
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  wordId      String?
  question    String
  correctAnswer String
  options     String[] // 객관식 보기
  type        QuestionType
  points      Int      @default(10)
  order       Int

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  word        Word?    @relation(fields: [wordId], references: [id])

  @@map("quiz_questions")
}

enum QuestionType {
  ENGLISH_TO_KOREAN
  KOREAN_TO_ENGLISH
  FILL_IN_BLANK
  LISTENING
  SPELLING
}

model QuizResult {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  totalPoints Int
  percentage  Float
  timeTaken   Int?     // 초 단위
  answers     Json     // 각 문제별 답변 기록
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

// ============================================
// 성취도 및 게임화 관련 모델
// ============================================

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  category    AchievementCategory
  requirement Int      // 달성 조건 수치
  points      Int      @default(10)
  isPremium   Boolean  @default(false)

  users       UserAchievement[]

  @@map("achievements")
}

enum AchievementCategory {
  LEARNING     // 학습 관련
  STREAK       // 연속 학습
  QUIZ         // 퀴즈 관련
  MASTERY      // 단어 마스터
  SOCIAL       // 소셜 활동
  SPECIAL      // 특별 이벤트
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0)

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model LearningStreak {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  wordsLearned Int     @default(0)
  quizzesTaken Int     @default(0)
  studyMinutes Int     @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("learning_streaks")
}

// ============================================
// 시뮬레이터 게임 관련 모델
// ============================================

model GameScore {
  id          String   @id @default(cuid())
  userId      String
  gameType    String   @default("SIMULATOR")
  score       Int
  day         Int      // 게임 내 생존 일수
  money       Int      // 최종 자금
  users       Int      // 최종 사용자 수
  totalRevenue Int
  totalExpenses Int
  metadata    Json?    // 추가 게임 데이터
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_scores")
}

// ============================================
// 카테고리 및 레벨 관련 모델
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  nameKorean  String
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  isPremium   Boolean  @default(false)
  wordCount   Int      @default(0)

  @@map("categories")
}

model Level {
  id          String   @id @default(cuid())
  number      Int      @unique
  name        String
  description String?
  requiredXP  Int
  rewards     Json?    // 레벨업 보상

  @@map("levels")
}
